<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="18dp"
            android:paddingEnd="26dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="@string/settings"
                android:textColor="#242228"
                android:textSize="17sp" />

            <FrameLayout
                android:id="@+id/clockContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">

                <com.phoenix.alarm.view.ClockRingView
                    android:id="@+id/clockRing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/timeClickArea"
                    android:layout_width="190dp"
                    android:layout_height="132dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/timeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.055"
                        android:text="7:00"
                        android:textColor="#242228"
                        android:textSize="44sp" />

                    <TextView
                        android:id="@+id/periodText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.05"
                        android:text="@string/am"
                        android:textColor="#242228"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/dayPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/settingsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <View
                    android:id="@+id/dividerTop"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEE8E2" />

                <LinearLayout
                    android:id="@+id/rowSounds"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:id="@+id/soundLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/sounds"
                        android:textColor="#746E69"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/soundValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:text="@string/sound_slow_rise"
                            android:textColor="#9A938C"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/chevronSounds"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/dividerSounds"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEE8E2" />

                <LinearLayout
                    android:id="@+id/rowRepeat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:id="@+id/repeatLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/repeat"
                        android:textColor="#746E69"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/repeatValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:text="Mon Wed Fri"
                            android:textColor="#9A938C"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/chevronRepeat"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/dividerRepeat"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEE8E2" />

                <LinearLayout
                    android:id="@+id/rowSnooze"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        android:id="@+id/snoozeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/snooze"
                        android:textColor="#746E69"
                        android:textSize="12sp" />

                    <com.phoenix.alarm.view.ToggleView
                        android:id="@+id/toggleSnooze"
                        android:layout_width="40dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/snooze" />
                </LinearLayout>

                <View
                    android:id="@+id/dividerSnooze"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEE8E2" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <Button
                    android:id="@+id/resetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:stateListAnimator="@null"
                    android:text="@string/reset"
                    android:textAllCaps="false"
                    android:textColor="#D99B94"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="78dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@null"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textColor="#FFFAF8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sheetContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFDFB"
        android:elevation="24dp"
        android:orientation="vertical"
        android:paddingStart="21dp"
        android:paddingTop="10dp"
        android:paddingEnd="21dp"
        android:paddingBottom="23dp"
        android:visibility="gone">

        <View
            android:id="@+id/sheetGrabber"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="15dp"
            android:background="#9A938C" />

        <LinearLayout
            android:id="@+id/timeSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timeSheetTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="@string/set_alarm"
                    android:textColor="#242228"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/timeSheetCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:padding="6dp"
                    android:text="@string/cancel"
                    android:textColor="#F58D82"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/hourUp"
                        android:layout_width="29dp"
                        android:layout_height="25dp"
                        android:background="#F5F0EB"
                        android:contentDescription="@string/time_picker_hour_up"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_up" />

                    <TextView
                        android:id="@+id/hourValue"
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.05"
                        android:text="07"
                        android:textColor="#242228"
                        android:textSize="36sp" />

                    <ImageButton
                        android:id="@+id/hourDown"
                        android:layout_width="29dp"
                        android:layout_height="25dp"
                        android:background="#F5F0EB"
                        android:contentDescription="@string/time_picker_hour_down"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_down" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text=":"
                    android:textColor="#9A938C"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/minuteUp"
                        android:layout_width="29dp"
                        android:layout_height="25dp"
                        android:background="#F5F0EB"
                        android:contentDescription="@string/time_picker_minute_up"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_up" />

                    <TextView
                        android:id="@+id/minuteValue"
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.05"
                        android:text="00"
                        android:textColor="#242228"
                        android:textSize="36sp" />

                    <ImageButton
                        android:id="@+id/minuteDown"
                        android:layout_width="29dp"
                        android:layout_height="25dp"
                        android:background="#F5F0EB"
                        android:contentDescription="@string/time_picker_minute_down"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_down" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/periodSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:background="#F5F0EB"
                    android:orientation="vertical"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/periodAm"
                        android:layout_width="34dp"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/am"
                        android:textColor="#9A938C"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/periodPm"
                        android:layout_width="34dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/pm"
                        android:textColor="#9A938C"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/timeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/minutes_hint"
                android:textColor="#9A938C"
                android:textSize="9.5sp" />

            <Button
                android:id="@+id/setTimeButton"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="15dp"
                android:background="#F58D82"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="@string/set_time"
                android:textAllCaps="false"
                android:textColor="#FFFAF8"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/soundSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/soundSheetTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="@string/sounds"
                    android:textColor="#242228"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/soundSheetDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:padding="6dp"
                    android:text="@string/done"
                    android:textColor="#F58D82"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/soundList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
